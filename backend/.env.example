APP_NAME=SmartSpace AI API
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+asyncpg://smartspace:smartspace@postgres:5432/smartspace_ai
SYNC_DATABASE_URL=postgresql://smartspace:smartspace@postgres:5432/smartspace_ai
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-this-secret-in-production
JWT_REFRESH_SECRET_KEY=change-this-refresh-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT=100/minute
UPLOAD_PROVIDER=local
S3_BUCKET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

